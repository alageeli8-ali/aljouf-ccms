<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>Ccms.Host</AssemblyName>
    <UserSecretsId>ccms-host</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Ccms.Contracts/Ccms.Contracts.csproj" />
    <ProjectReference Include="../Ccms.Modules.Iam/Ccms.Modules.Iam.csproj" />
    <ProjectReference Include="../Ccms.Modules.Org/Ccms.Modules.Org.csproj" />
    <ProjectReference Include="../Ccms.Modules.Configuration/Ccms.Modules.Configuration.csproj" />
    <ProjectReference Include="../Ccms.Modules.Audit/Ccms.Modules.Audit.csproj" />
    <ProjectReference Include="../Ccms.Modules.Notifications/Ccms.Modules.Notifications.csproj" />
    <ProjectReference Include="../Ccms.Modules.Bodies/Ccms.Modules.Bodies.csproj" />
    <ProjectReference Include="../Ccms.Modules.Meetings/Ccms.Modules.Meetings.csproj" />
    <ProjectReference Include="../Ccms.Modules.Minutes/Ccms.Modules.Minutes.csproj" />
    <ProjectReference Include="../Ccms.Modules.Resolutions/Ccms.Modules.Resolutions.csproj" />
    <ProjectReference Include="../Ccms.Modules.Tasks/Ccms.Modules.Tasks.csproj" />
    <ProjectReference Include="../Ccms.Modules.Signatures/Ccms.Modules.Signatures.csproj" />
    <ProjectReference Include="../Ccms.Modules.Ai/Ccms.Modules.Ai.csproj" />
    <ProjectReference Include="../Ccms.Modules.Documents/Ccms.Modules.Documents.csproj" />
    <ProjectReference Include="../Ccms.Modules.Reporting/Ccms.Modules.Reporting.csproj" />
    <ProjectReference Include="../Ccms.Modules.Integrations/Ccms.Modules.Integrations.csproj" />
  </ItemGroup>
  <!-- بناء الإنتاج: dotnet publish -p:UseNpgsql=true (يتطلب الوصول إلى NuGet) -->
  <ItemGroup Condition="'$(UseNpgsql)' == 'true'">
    <PackageReference Include="Npgsql" Version="9.0.3" />
  </ItemGroup>
  <!-- بيئات التطوير والاختبار دون اتصال: الموصل المصغّر (ADR-015) -->
  <ItemGroup Condition="'$(UseNpgsql)' != 'true'">
    <ProjectReference Include="../Ccms.Data.PgWire/Ccms.Data.PgWire.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../../db/migrations/*.sql" LinkBase="migrations" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="Ccms.Tests" />
  </ItemGroup>
</Project>
