{
  "App": { "Version": "0.1.0" },
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "App": "",
    "Migrations": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "MigrationsPath": ""
  },
  "Authentication": {
    "LocalLogin": { "Enabled": false, "BreakGlassOnly": true, "MaxFailedAttempts": 5, "LockoutMinutes": 15 },
    "Session": { "IdleMinutes": 30, "MaxHours": 10 },
    "Entra": {
      "Instance": "https://login.microsoftonline.com/",
      "TenantId": "",
      "ClientId": "",
      "ClientSecret": "",
      "CallbackPath": "/auth/sso/callback",
      "AutoProvisionUsers": true,
      "AllowedEmailDomains": [ "jsdo.gov.sa" ]
    }
  },
  "FeatureManagement": {
    "Locks": {}
  },
  "Integrations": {
    "Ai": { "BaseUrl": "", "Model": "", "ApiKey": "", "AllowedHosts": [] },
    "Email": { "Provider": "none", "SmtpHost": "", "SmtpPort": 587, "UseSsl": true, "From": "", "Username": "", "Password": "" },
    "ESign": { "NationalProviderBaseUrl": "" },
    "Correspondence": { "BaseUrl": "" }
  },
  "Storage": { "Path": "storage", "MaxSizeMb": 50 },
  "Workers": { "Enabled": true },
  "RateLimits": { "LoginPerMinute": 10 }
}
